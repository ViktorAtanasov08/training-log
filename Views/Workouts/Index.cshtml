@model IReadOnlyList<WorkoutEntry>
@{
    ViewData["Title"] = "Workout journal";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">BUILD YOUR PROGRESS</p>
        <h1>Workout journal</h1>
        <p class="muted">Record your exercises, one session at a time.</p>
    </div>
    <a class="button" asp-action="Create">Log an exercise</a>
</div>
<p class="notice">This first version uses temporary storage. Entries reset when the app restarts.</p>

@if (Model.Count == 0)
{
    <section class="card empty-state">
        <h2>Your first entry starts here.</h2>
        <p class="muted">Choose an exercise and record the sets, reps and weight you completed.</p>
        <a asp-action="Create">Add your first exercise &rarr;</a>
    </section>
}
else
{
    <section class="card table-container" aria-label="Logged exercises">
        <table>
            <thead>
                <tr><th>Date</th><th>Exercise</th><th>Sets</th><th>Reps</th><th>Weight</th></tr>
            </thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    <tr>
                        <td>@entry.Date.ToString("dd MMM yyyy")</td>
                        <td><strong>@entry.Exercise</strong></td>
                        <td>@entry.Sets</td>
                        <td>@entry.Reps</td>
                        <td>@entry.WeightKg.ToString("0.##") kg</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}
